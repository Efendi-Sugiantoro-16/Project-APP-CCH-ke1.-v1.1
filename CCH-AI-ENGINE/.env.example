# ============================================================================
# CCH AI ENGINE - ENVIRONMENT CONFIGURATION TEMPLATE
# PT Pos Indonesia (Persero) - Customer Complaint Handling
# Multi-Tier Cognitive AI & Autonomous Social Media Scraping Worker
# ============================================================================

# Target Environment: development | staging | production
ENVIRONMENT=development
PORT=8000
DEBUG=true

# ============================================================================
# 1. PRIMARY LLM PROVIDER & MODEL SELECTION
# Pilihan Provider: openai | gemini | mistral | deepseek | ollama | rule_based
# ============================================================================
PRIMARY_LLM_PROVIDER=openai

# OpenAI Config
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-6-luna

# Google Gemini Config
GEMINI_API_KEY=AIzaSy-your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# Mistral AI Config
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-small-latest

# DeepSeek Config
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat

# On-Premise Local Ollama (vLLM / Ollama PII Protection)
LOCAL_OLLAMA_URL=http://localhost:11434/v1
LOCAL_OLLAMA_MODEL=qwen2.5:7b

# Router / 9Router (Optional Fallback)
9ROUTER_API_KEY=
9ROUTER_URL=http://localhost:20128/v1

# ============================================================================
# 2. MARIADB / MYSQL DATABASE CCH CONNECTION
# ============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cch
DB_POOL_SIZE=5

# CCH Backend Go Fiber URL
CCH_BE_URL=http://localhost:8081
AI_SERVICE_TOKEN=cch-ai-virtual-cs-secret-key-2026

# ============================================================================
# 3. AUTONOMOUS AGENTIC SCRAPER & INTAKE WORKER
# ============================================================================
AGENTIC_AUTO_POLL_ENABLED=true
AGENTIC_POLL_INTERVAL_SECONDS=60
AGENTIC_AUTO_CREATE_TICKET=true
AGENTIC_AUTO_REPLY=true
AGENTIC_DRY_RUN=false
AGENTIC_MIN_URGENCY_TO_TICKET=P2_TINGGI

# ============================================================================
# 4. SOCIAL MEDIA & TELEGRAM WEBHOOK CREDENTIALS
# ============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=cch_posind_meta_verify_token_2026

TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=

